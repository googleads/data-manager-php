{
    "name": "googleads/data-manager-util",
    "description": "Utilities for working with the Data Manager API and PHP.",
    "type": "library",
    "keywords": [
        "google",
        "data-manager",
        "ads",
        "utilities"
    ],
    "homepage": "https://developers.google.com/data-manager",
    "license": "Apache-2.0",
    "support": {
        "issues": "https://github.com/googleads/data-manager-php/issues",
        "source": "https://github.com/googleads/data-manager-php"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "google/cloud-tools": "dev-main",
        "squizlabs/php_codesniffer": "^3.5",
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.46"
    },
    "autoload": {
        "psr-4": {
            "Google\\Ads\\DataManagerUtil\\": "src/Google/Ads/DataManagerUtil/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Google\\Ads\\DataManagerUtil\\": "tests/Google/Ads/DataManagerUtil/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "fix": "php-cs-fixer fix"
    }
}
